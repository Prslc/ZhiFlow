# IntelliJ / Android Studio
# The IDE's own settings stay on the machine that wrote them: Studio rewrites those files on its
# own schedule, so tracking them buys diffs nobody made. What the project insists on lives in
# `.editorconfig`, which every editor reads.
*.iml
/.idea/

# Gradle
.gradle
/build
/captures
.externalNativeBuild
.cxx

# Local properties
local.properties

# Signing credentials
keystore.properties

# OS generated
.DS_Store

# Kotlin
*.kotlin_module
.kotlin/

# Native libraries (distributed separately for release builds)
/app/libs/

# Claude Code (MCP servers, with paths local to this machine)
.mcp.json
