# Read by Android Studio, IntelliJ, and anything else that speaks EditorConfig -- including
# linters. This is where the project's style is stated, so that it survives a machine and does not
# depend on an IDE settings file. Both values below were measured off the sources, not picked.
root = true

[*.{kt,kts}]
ij_kotlin_code_style_defaults = KOTLIN_OFFICIAL
# The code wraps at 100: of 14564 lines, 87 run longer, and those are the ones that cannot be
# broken (a one-line data class, a long `when` condition). Comments follow the same margin.
max_line_length = 100
# Nowhere in the repo are two blank lines kept in a row.
ij_kotlin_keep_blank_lines_in_code = 1
ij_kotlin_keep_blank_lines_in_declarations = 1
ij_kotlin_keep_blank_lines_before_right_brace = 1

# Vendored from InstallerX Revived and kept as it came, down to the 135-column comment, so the
# margin above does not apply to them. That is the only rule of ours they disagree with: their
# import order and their blank lines already match. Add a section when another file is vendored in.
[app/src/main/java/com/prslc/zhiflow/ui/component/preference/SegmentedColumn.kt]
max_line_length = off

[app/src/main/java/com/prslc/zhiflow/ui/component/preference/BaseWidget.kt]
max_line_length = off

[app/src/main/java/com/prslc/zhiflow/ui/component/preference/NavigationItemWidget.kt]
max_line_length = off
